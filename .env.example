POSTGRES_DB=seabridge_erp

# Connection string used by the API and Prisma when running outside Docker.
# Must match the three values above.
DATABASE_URL=postgresql://seabridge:change_this_database_password@localhost:5432/seabridge_erp

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT Authentication ----------
# CHANGE THIS before anyone else can reach the app. Anyone who knows this value
# can forge a login token for any user.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- API Server ----------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---------- Frontend ----------
# Leave EMPTY for local development - the Vite dev server proxies /api to the
# API on port 4000. Only set this if the frontend must call an API on another
# host, and include the /api suffix, e.g. https://erp.example.com/api
VITE_API_URL=

# ---------- PDF Generation ----------
PDF_STORAGE_PATH=./storage/pdfs

# ---------- Company Branding ----------
COMPANY_NAME=SeaBridge Exports
COMPANY_PRIMARY_COLOR=#1e3a5f
COMPANY_SECONDARY_COLOR=#c9a227
