# Copy this file to .env and adjust the values.
#   PowerShell : Copy-Item .env.example .env
#   CMD        : copy .env.example .env
#   bash       : cp .env.example .env
#
# .env is gitignored - never commit real credentials.

# ---------- Database ----------
# These three are read by docker-compose to create the Postgres container.
POSTGRES_USER=seabridge
# REQUIRED - generate a strong password before first run:
#   PowerShell : -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
#   bash       : openssl rand -base64 24
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>
POSTGRES_DB=seabridge_erp

# Connection string used by the API and Prisma when running outside Docker.
# Must match the three values above. Replace <GENERATE_STRONG_PASSWORD_HERE>
# with the same password you set for POSTGRES_PASSWORD.
DATABASE_URL=postgresql://seabridge:<GENERATE_STRONG_PASSWORD_HERE>@localhost:5432/seabridge_erp

# ---------- JWT Authentication ----------
# REQUIRED - generate a random secret of at least 32 characters:
#   PowerShell : -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
#   bash       : openssl rand -base64 48
# Anyone who knows this value can forge a login token for any user.
JWT_SECRET=<GENERATE_AT_LEAST_32_RANDOM_CHARACTERS>
JWT_EXPIRES_IN=7d

# ---------- API Server ----------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---------- Frontend ----------
# Leave EMPTY for local development - the Vite dev server proxies /api to the
# API on port 4000. Only set this if the frontend must call an API on another
# host, and include the /api suffix, e.g. https://erp.example.com/api
VITE_API_URL=

# ---------- PDF Generation ----------
PDF_STORAGE_PATH=./storage/pdfs

# ---------- Company Branding ----------
COMPANY_NAME=SeaBridge Exports
COMPANY_PRIMARY_COLOR=#1e3a5f
COMPANY_SECONDARY_COLOR=#c9a227

# ---------- Email (SMTP) ----------
# Optional - configure to enable email notifications
# Leave blank to disable email features
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@seabridge.com
SMTP_FROM_NAME=SeaBridge ERP
