# Copy this file to .env and set real values.
#   PowerShell : Copy-Item .env.example .env
#   CMD        : copy .env.example .env
#   bash       : cp .env.example .env
#
# .env is gitignored - never commit real credentials.
#
# This file is committed to a public repository, so every value below is a
# PLACEHOLDER. Replace all of them marked CHANGE_ME before deploying anywhere
# that is reachable by anyone else. deploy.cmd refuses to start if they are
# left as-is.

# ---------- Database ----------
# These three are read by docker-compose to create the Postgres container.
POSTGRES_USER=seabridge
# CHANGE_ME - generate one:
#   PowerShell : -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
#   bash       : openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=seabridge_erp

# Connection string used by the API and Prisma when running outside Docker.
# The password here MUST match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://seabridge:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/seabridge_erp

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT Authentication ----------
# CHANGE_ME. Anyone who knows this value can forge a login token for any user,
# including the founder account. Use at least 32 random characters:
#   PowerShell : -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
#   bash       : openssl rand -base64 36
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# ---------- API Server ----------
PORT=4000
NODE_ENV=development
# Must be the exact origin the browser loads the app from, or logins will fail
# CORS. In production this is your real domain, e.g. https://erp.example.com
CORS_ORIGIN=http://localhost:3000

# ---------- Frontend ----------
# Leave EMPTY for local development - the Vite dev server proxies /api to the
# API on port 4000. Only set this if the frontend must call an API on another
# host, and include the /api suffix, e.g. https://erp.example.com/api
VITE_API_URL=

# ---------- PDF Generation ----------
PDF_STORAGE_PATH=./storage/pdfs

# ---------- Initial Seed ----------
# Optional. Set this before running "prisma db seed" to control the founder
# account password on a fresh database. If left unset, the seed generates a
# random password and prints it ONCE to stdout — copy it immediately.
# Never set this to a predictable value in a production environment.
# SEED_FOUNDER_PASSWORD=

# ---------- Company Branding ----------
# The exporter details printed on documents are stored in the database and
# edited under Settings > Company, not here. These only affect the browser tab
# and theme colours.
COMPANY_NAME=SeaBridge Exports
COMPANY_PRIMARY_COLOR=#1e3a5f
COMPANY_SECONDARY_COLOR=#c9a227
