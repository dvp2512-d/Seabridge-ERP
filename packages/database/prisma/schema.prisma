// SeaBridge Founder OS - Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

enum UserRole {
  FOUNDER
  SALES
  OPERATIONS
  FINANCE
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  role         UserRole   @default(SALES)
  status       UserStatus @default(ACTIVE)
  phone        String?
  avatar       String?
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  employee         Employee?
  createdInquiries Inquiry[]       @relation("InquiryCreatedBy")
  ownedInquiries   Inquiry[]       @relation("InquirySalesOwner")
  tasks            Task[]          @relation("TaskAssignee")
  createdTasks     Task[]          @relation("TaskCreatedBy")
  communications   Communication[]
  auditLogs        AuditLog[]
  incomeEntries    Income[]
  revisedQuotations Quotation[]
  uploadedAttachments Attachment[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

// ============================================
// MASTER DATA - GEOGRAPHY
// ============================================

model Country {
  id        String   @id @default(cuid())
  code      String   @unique // ISO 3166-1 alpha-2
  name      String
  region    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  buyers     Buyer[]
  ports      Port[]
  suppliers  Supplier[]

  @@map("countries")
}

model Port {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  countryId String   @map("country_id")
  type      String   @default("SEA") // SEA, AIR, LAND
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  country              Country       @relation(fields: [countryId], references: [id])
  shipmentsOrigin      Shipment[]    @relation("ShipmentOriginPort")
  shipmentsDestination Shipment[]    @relation("ShipmentDestinationPort")
  quotationsLoading    Quotation[]   @relation("QuotationLoadingPort")
  quotationsDischarge  Quotation[]   @relation("QuotationDischargePort")
  ordersLoading        ExportOrder[] @relation("OrderLoadingPort")
  ordersDischarge      ExportOrder[] @relation("OrderDischargePort")

  @@map("ports")
}

// A currency is a presentation choice, not a unit of storage.
//
// Every monetary column in this schema is in INR. A currency and an exchange rate
// are chosen at the moment a document is generated, and recorded on that document
// (see Quotation.pdfCurrency / Invoice.pdfCurrency). There is deliberately no rate
// stored here: a single mutable rate meant every historical total silently
// re-priced whenever it was edited.
model Currency {
  id           String   @id @default(cuid())
  code         String   @unique // ISO 4217
  name         String
  symbol       String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  // Buyers keep a preferred currency, which seeds the document dialog.
  buyers Buyer[]

  @@map("currencies")
}

model Incoterm {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  quotations Quotation[]
  orders     ExportOrder[]

  @@map("incoterms")
}



// ============================================
// MASTER DATA - PRODUCTS
// ============================================

model ProductCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  products Product[]

  @@map("product_categories")
}

model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  categoryId  String   @map("category_id")
  hsnCode     String?  @map("hsn_code")
  unit        String   @default("KG") // KG, MT, PCS, CTN, etc.
  // GST rate for domestic purchases of this product, in percent.
  //
  // Prefills the tax on a purchase order line so it does not have to be looked up
  // per order. Rates follow the HSN code and differ by product - psyllium is not
  // taxed at the same rate as packaging - so it belongs on the product rather than
  // as one rate per purchase order.
  //
  // Null means unknown rather than zero: an unknown rate leaves the line's tax
  // blank for someone to fill in, where zero would silently understate the total.
  gstRate     Decimal? @map("gst_rate") @db.Decimal(5, 2)
  // Default packaging for this product. Prefills the packing on a quotation line
  // when no buyer-specific packing was requested at inquiry stage, and serves as
  // the fallback for fillOrderPacking when the quotation itself had no packing set.
  //
  // Null means no default: the packing must be specified per order, which is
  // appropriate for products that are always sold to the buyer's own spec.
  defaultPackageType   String?  @map("default_package_type")
  defaultPackageWeight Decimal? @map("default_package_weight") @db.Decimal(12, 3)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  category       ProductCategory  @relation(fields: [categoryId], references: [id])
  supplierPrices SupplierPrice[]
  inquiryItems   InquiryItem[]
  quotationItems QuotationItem[]
  orderItems     OrderItem[]
  /// Purchase order lines for this product, at supplier prices.
  procurementItems ProcurementItem[]

  @@map("products")
}



// ============================================
// MASTER DATA - SUPPLIERS & SERVICE PROVIDERS
// ============================================

model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?  @map("contact_person")
  email         String?
  phone         String?
  address       String?
  countryId     String?  @map("country_id")
  gstNumber     String?  @map("gst_number")
  panNumber     String?  @map("pan_number")
  bankDetails   String?  @map("bank_details")
  paymentTerms  String?  @map("payment_terms")
  rating        Int?     @default(0) // 1-5 rating
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  country        Country?        @relation(fields: [countryId], references: [id])
  supplierPrices SupplierPrice[]
  procurements   Procurement[]

  @@map("suppliers")
}

model SupplierPrice {
  id          String   @id @default(cuid())
  supplierId  String   @map("supplier_id")
  productId   String   @map("product_id")
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  unit        String   @default("KG")
  minQuantity Decimal? @map("min_quantity") @db.Decimal(12, 2)
  validFrom   DateTime @map("valid_from")
  validTo     DateTime? @map("valid_to")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("supplier_prices")
}

model CHA {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?  @map("contact_person")
  email         String?
  phone         String?
  address       String?
  licenseNumber String?  @map("license_number")
  rating        Int?     @default(0)
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  chaRates  CHARate[]
  shipments Shipment[]

  @@map("cha_agents")
}

model CHARate {
  id            String   @id @default(cuid())
  chaId         String   @map("cha_id")
  serviceType   String   @map("service_type") // CUSTOMS_CLEARANCE, DOCUMENTATION, etc.
  rate          Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR")
  containerType String?  @map("container_type") // 20FT, 40FT, LCL
  validFrom     DateTime @map("valid_from")
  validTo       DateTime? @map("valid_to")
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  cha CHA @relation(fields: [chaId], references: [id])

  @@map("cha_rates")
}

model Transporter {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?  @map("contact_person")
  email         String?
  phone         String?
  address       String?
  serviceType   String   @default("ROAD") @map("service_type") // ROAD, RAIL, SEA, AIR
  rating        Int?     @default(0)
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  transportRates TransportRate[]
  shipments      Shipment[]

  @@map("transporters")
}

model TransportRate {
  id            String   @id @default(cuid())
  transporterId String   @map("transporter_id")
  origin        String
  destination   String
  rate          Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR")
  containerType String?  @map("container_type")
  transitDays   Int?     @map("transit_days")
  validFrom     DateTime @map("valid_from")
  validTo       DateTime? @map("valid_to")
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  transporter Transporter @relation(fields: [transporterId], references: [id])

  @@map("transport_rates")
}



// ============================================
// CRM - BUYER MANAGEMENT
// ============================================

enum BuyerStatus {
  LEAD
  PROSPECT
  ACTIVE
  INACTIVE
  CHURNED
}

model Buyer {
  id              String      @id @default(cuid())
  code            String      @unique
  companyName     String      @map("company_name")
  tradeName       String?     @map("trade_name")
  countryId       String      @map("country_id")
  address         String?
  city            String?
  state           String?
  postalCode      String?     @map("postal_code")
  website         String?
  industry        String?
  status          BuyerStatus @default(LEAD)
  source          String?     // EXHIBITION, REFERRAL, WEBSITE, etc.
  currencyId      String?     @map("currency_id")
  paymentTerms    String?     @map("payment_terms")
  creditLimit     Decimal?    @map("credit_limit") @db.Decimal(15, 2)
  creditDays      Int?        @map("credit_days")
  taxId           String?     @map("tax_id")
  notes           String?
  totalRevenue    Decimal     @default(0) @map("total_revenue") @db.Decimal(15, 2)
  totalOrders     Int         @default(0) @map("total_orders")
  lastOrderDate   DateTime?   @map("last_order_date")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  country        Country         @relation(fields: [countryId], references: [id])
  currency       Currency?       @relation(fields: [currencyId], references: [id])
  contacts       BuyerContact[]
  communications Communication[]
  inquiries      Inquiry[]
  quotations     Quotation[]
  orders         ExportOrder[]
  /// Orders where this buyer is invoiced but the goods go to another consignee.
  billedOrders   ExportOrder[]   @relation("OrderBillToBuyer")
  invoices       Invoice[]

  @@map("buyers")
}

model BuyerContact {
  id          String   @id @default(cuid())
  buyerId     String   @map("buyer_id")
  firstName   String   @map("first_name")
  lastName    String?  @map("last_name")
  designation String?
  email       String?
  phone       String?
  mobile      String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@map("buyer_contacts")
}

model Communication {
  id        String   @id @default(cuid())
  buyerId   String   @map("buyer_id")
  userId    String   @map("user_id")
  type      String   // EMAIL, CALL, MEETING, WHATSAPP, etc.
  subject   String?
  content   String?
  direction String   @default("OUTBOUND") // INBOUND, OUTBOUND
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@map("communications")
}



// ============================================
// SALES - INQUIRY & PIPELINE
// ============================================

enum InquiryStage {
  NEW
  REQUIREMENT_GATHERED
  PRICING_IN_PROGRESS
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
  ON_HOLD
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Inquiry {
  id              String          @id @default(cuid())
  inquiryNumber   String          @unique @map("inquiry_number")
  buyerId         String          @map("buyer_id")
  salesOwnerId    String          @map("sales_owner_id")
  createdById     String          @map("created_by_id")
  stage           InquiryStage    @default(NEW)
  priority        InquiryPriority @default(MEDIUM)
  source          String?         // EMAIL, PHONE, WEBSITE, EXHIBITION
  expectedValue   Decimal?        @map("expected_value") @db.Decimal(15, 2)
  expectedDate    DateTime?       @map("expected_date")
  requirements    String?
  notes           String?
  lostReason      String?         @map("lost_reason")
  nextFollowUp    DateTime?       @map("next_follow_up")
  nextAction      String?         @map("next_action")
  closedAt        DateTime?       @map("closed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  buyer       Buyer         @relation(fields: [buyerId], references: [id])
  salesOwner  User          @relation("InquirySalesOwner", fields: [salesOwnerId], references: [id])
  createdBy   User          @relation("InquiryCreatedBy", fields: [createdById], references: [id])
  items       InquiryItem[]
  quotations  Quotation[]
  followUps   FollowUp[]

  @@map("inquiries")
}

model InquiryItem {
  id              String   @id @default(cuid())
  inquiryId       String   @map("inquiry_id")
  productId       String   @map("product_id")
  quantity        Decimal  @db.Decimal(12, 2)
  unit            String   @default("KG")
  targetPrice     Decimal? @map("target_price") @db.Decimal(12, 2)
  // How the buyer wants the goods packed.
  //
  // Asked at inquiry stage because it changes the price - 25kg bags and 1000kg jumbo
  // bags cost differently to fill, and a buyer who needs cartons for retail shelves
  // is buying a different thing from one taking bulk sacks. Recorded here so the
  // requirement is not lost between the enquiry and the packing list, and carried
  // through the quotation onto the order.
  //
  // Null means the buyer did not specify, in which case the product's own default
  // packaging applies.
  packageType     String?  @map("package_type")
  /// Net weight the buyer wants in each package, in kilograms.
  packageWeight   Decimal? @map("package_weight") @db.Decimal(12, 3)
  specifications  String?
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("inquiry_items")
}

model FollowUp {
  id          String    @id @default(cuid())
  inquiryId   String    @map("inquiry_id")
  scheduledAt DateTime  @map("scheduled_at")
  completedAt DateTime? @map("completed_at")
  type        String    // CALL, EMAIL, MEETING, VISIT
  notes       String?
  outcome     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@map("follow_ups")
}



// ============================================
// COSTING & QUOTATION
// ============================================

enum QuotationStatus {
  DRAFT
  SENT
  REVISED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id                  String          @id @default(cuid())
  quotationNumber     String          @unique @map("quotation_number")
  inquiryId           String?         @map("inquiry_id")
  buyerId             String          @map("buyer_id")
  incotermId          String          @map("incoterm_id")
  portOfLoadingId     String?         @map("port_of_loading_id")
  portOfDischargeId   String?         @map("port_of_discharge_id")
  dispatchMethod      String?         @map("dispatch_method")
  shipmentType        String?         @map("shipment_type")
  status              QuotationStatus @default(DRAFT)
  validUntil          DateTime        @map("valid_until")
  deliveryTerms       String?         @map("delivery_terms")
  paymentTerms        String?         @map("payment_terms")
  subtotal            Decimal         @default(0) @db.Decimal(15, 2)
  totalCost           Decimal         @default(0) @map("total_cost") @db.Decimal(15, 2)
  totalMargin         Decimal         @default(0) @map("total_margin") @db.Decimal(15, 2)
  marginPercent       Decimal         @default(0) @map("margin_percent") @db.Decimal(5, 2)
  grandTotal          Decimal         @default(0) @db.Decimal(15, 2) @map("grand_total")
  // Presentation currency for the printed quotation. All amounts above are INR;
  // these record what the buyer's copy was expressed in and at what rate, so a
  // regenerated PDF reproduces the document that was actually sent.
  // pdfExchangeRate is INR per one unit of pdfCurrency.
  pdfCurrency         String?         @map("pdf_currency")
  pdfExchangeRate     Decimal?        @map("pdf_exchange_rate") @db.Decimal(12, 6)
  pdfGeneratedAt      DateTime?       @map("pdf_generated_at")
  notes               String?
  termsConditions     String?         @map("terms_conditions")
  sentAt              DateTime?       @map("sent_at")
  acceptedAt          DateTime?       @map("accepted_at")
  pdfPath             String?         @map("pdf_path")
  // Version tracking - quotation number stays the same, version increments on revision.
  // Version 1 is the original, version 2 is the first revision, etc.
  version             Int             @default(1)
  // Reason for revision, recorded when creating a new version.
  revisionReason      String?         @map("revision_reason")
  // Who created this version, null for v1 (use createdAt).
  revisedById         String?         @map("revised_by_id")
  revisedAt           DateTime?       @map("revised_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  // Relations
  inquiry         Inquiry?           @relation(fields: [inquiryId], references: [id])
  buyer           Buyer              @relation(fields: [buyerId], references: [id])
  incoterm        Incoterm           @relation(fields: [incotermId], references: [id])
  portOfLoading   Port?              @relation("QuotationLoadingPort", fields: [portOfLoadingId], references: [id])
  portOfDischarge Port?              @relation("QuotationDischargePort", fields: [portOfDischargeId], references: [id])
  revisedBy       User?              @relation(fields: [revisedById], references: [id])
  items           QuotationItem[]
  costs           QuotationCost[]
  orders          ExportOrder[]
  history         QuotationHistory[]

  @@map("quotations")
}

// Tracks the history of quotation revisions.
// Each time a quotation is revised, a snapshot of the previous version is stored here.
model QuotationHistory {
  id              String   @id @default(cuid())
  quotationId     String   @map("quotation_id")
  version         Int
  // Snapshot of key fields at this version
  subtotal        Decimal  @db.Decimal(15, 2)
  totalCost       Decimal  @map("total_cost") @db.Decimal(15, 2)
  totalMargin     Decimal  @map("total_margin") @db.Decimal(15, 2)
  marginPercent   Decimal  @map("margin_percent") @db.Decimal(5, 2)
  grandTotal      Decimal  @map("grand_total") @db.Decimal(15, 2)
  validUntil      DateTime @map("valid_until")
  paymentTerms    String?  @map("payment_terms")
  deliveryTerms   String?  @map("delivery_terms")
  status          String
  // JSON snapshot of items at this version
  itemsSnapshot   Json     @map("items_snapshot")
  // JSON snapshot of costs at this version
  costsSnapshot   Json     @map("costs_snapshot")
  // Who created this version
  createdById     String   @map("created_by_id")
  revisionReason  String?  @map("revision_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId, version])
  @@map("quotation_history")
}

model QuotationItem {
  id              String  @id @default(cuid())
  quotationId     String  @map("quotation_id")
  productId       String  @map("product_id")
  quantity        Decimal @db.Decimal(12, 2)
  unit            String  @default("KG")
  unitCost        Decimal @map("unit_cost") @db.Decimal(12, 2)
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)
  totalCost       Decimal @map("total_cost") @db.Decimal(15, 2)
  totalPrice      Decimal @map("total_price") @db.Decimal(15, 2)
  margin          Decimal @default(0) @db.Decimal(15, 2)
  marginPercent   Decimal @default(0) @map("margin_percent") @db.Decimal(5, 2)
  // The packing this line is quoted on, carried from the inquiry and editable.
  //
  // It belongs on the quotation because it is part of what was agreed: a price for
  // 25kg bags is not a price for jumbo bags. Carried onto the order line when the
  // quotation is converted, so the packing list states what the buyer actually
  // agreed to rather than the product's generic default.
  packageType     String?  @map("package_type")
  /// Net weight per package, in kilograms.
  packageWeight   Decimal? @map("package_weight") @db.Decimal(12, 3)
  specifications  String?
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

model QuotationCost {
  id          String   @id @default(cuid())
  quotationId String   @map("quotation_id")
  costType    String   @map("cost_type") // SUPPLIER, CHA, TRANSPORT, PACKAGING, OTHER
  description String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_costs")
}



// ============================================
// EXPORT OPERATIONS
// ============================================

enum OrderStatus {
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

model ExportOrder {
  id                String      @id @default(cuid())
  orderNumber       String      @unique @map("order_number")
  quotationId       String      @map("quotation_id")
  buyerId           String      @map("buyer_id")
  incotermId        String      @map("incoterm_id")
  portOfLoadingId   String?     @map("port_of_loading_id")
  portOfDischargeId String?     @map("port_of_discharge_id")
  status            OrderStatus @default(CONFIRMED)
  poNumber          String?     @map("po_number")
  orderDate         DateTime    @map("order_date")
  expectedDate      DateTime?   @map("expected_date")
  // Header fields printed on every document raised against this order, carried
  // over from the quotation. Created by migration 20260816000000_export_documents.
  dispatchMethod    String?     @map("dispatch_method") // SEA, AIR, ROAD
  shipmentType      String?     @map("shipment_type")   // FCL, LCL
  /// Quantity tolerance stated on a proforma invoice, in percent.
  variationPercent  Decimal?    @map("variation_percent") @db.Decimal(5, 2)
  // The party invoiced, when it is not the consignee receiving the goods.
  //
  // Prints in the "Buyer ( If Other than Consinee )" box of every invoice-family
  // document. Null is the normal case - the buyer and the consignee are the same -
  // and the box prints empty, which is what the master draft shows.
  billToBuyerId     String?     @map("bill_to_buyer_id")
  // INR, like every monetary column in this schema.
  totalValue        Decimal     @map("total_value") @db.Decimal(15, 2)
  paymentTerms      String?     @map("payment_terms")
  deliveryTerms     String?     @map("delivery_terms")
  notes             String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Relations
  quotation       Quotation     @relation(fields: [quotationId], references: [id])
  buyer           Buyer         @relation(fields: [buyerId], references: [id])
  /// The party invoiced when it differs from the consignee.
  billToBuyer     Buyer?        @relation("OrderBillToBuyer", fields: [billToBuyerId], references: [id])
  incoterm        Incoterm      @relation(fields: [incotermId], references: [id])
  portOfLoading   Port?         @relation("OrderLoadingPort", fields: [portOfLoadingId], references: [id])
  portOfDischarge Port?         @relation("OrderDischargePort", fields: [portOfDischargeId], references: [id])
  items           OrderItem[]
  procurements    Procurement[]
  documents       Document[]
  shipments       Shipment[]
  invoices        Invoice[]

  @@index([billToBuyerId])
  @@map("export_orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  quantity    Decimal  @db.Decimal(12, 2)
  unit        String   @default("KG")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(15, 2)
  // Packing figures for this line. These are the four columns of the Packing List
  // and the weight block on every invoice, so they are declared rather than
  // derived: gross weight depends on the packaging used and the number of packages
  // on how it was filled, and neither can be inferred from a quantity.
  //
  // Created by migration 20260816000000_export_documents. Nullable, because an
  // order is priced before it is packed.
  numberOfPackages Int?     @map("number_of_packages")
  // What the goods are packed in on this line: BAG, CARTON, DRUM, BOX and so on.
  //
  // Prefilled from the product's default, but held per line because a product
  // normally shipped in 25kg bags is sometimes shipped in cartons, and the packing
  // list has to state what was actually used. A package count without its type is
  // not a figure a customs officer or a shipping line can act on.
  packageType      String?  @map("package_type")
  /// Net weight carried by one package, i.e. the "Bag / Carton Per KGs" column.
  packageWeight    Decimal? @map("package_weight") @db.Decimal(12, 3)
  netWeight        Decimal? @map("net_weight") @db.Decimal(12, 3)
  grossWeight      Decimal? @map("gross_weight") @db.Decimal(12, 3)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  order   ExportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Procurement {
  id           String    @id @default(cuid())
  orderId      String    @map("order_id")
  supplierId   String    @map("supplier_id")
  poNumber     String?   @unique @map("po_number")
  status       String    @default("PENDING") // PENDING, ORDERED, RECEIVED, PARTIAL
  orderDate    DateTime? @map("order_date")
  expectedDate DateTime? @map("expected_date")
  receivedDate DateTime? @map("received_date")
  // What was agreed with the supplier, in INR.
  //
  // All three are computed from the line items on every write and are never taken
  // from the client - a total that can be typed independently of the lines is a
  // total that will eventually disagree with them. subtotal is the taxable value,
  // taxAmount the GST on it, and totalAmount what the supplier will actually be
  // paid.
  //
  // A procurement with no lines keeps whatever total it was created with, so
  // purchase orders raised before line items existed still show their agreed value.
  subtotal     Decimal   @default(0) @db.Decimal(15, 2)
  taxAmount    Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount  Decimal   @map("total_amount") @db.Decimal(15, 2)
  currency     String    @default("INR")

  // The boxes on the PO sheet that had no field behind them, so a purchase order
  // printed blank where the supplier needs an instruction. All optional: a PO for
  // a repeat local pickup needs few of them.
  /// Where goods are to be delivered, when not the purchaser's own address.
  deliveryAddress    String? @map("delivery_address")
  /// Road, rail, ex-factory pickup.
  modeOfDelivery     String? @map("mode_of_delivery")
  /// Expected payment terms, e.g. "50% advance, 50% on delivery".
  paymentMode        String? @map("payment_mode")
  /// Where the goods are collected from.
  pickupLocation     String? @map("pickup_location")
  /// Where they are going - warehouse, port, ICD.
  destination        String? @map("destination")
  /// Packing specification placed on the supplier, e.g. "25kg HDPE bags with liner".
  packingInstructions String? @map("packing_instructions")
  /// Quality specification, e.g. batch-wise COA with stated parameters.
  qualityRequirement String? @map("quality_requirement")
  /// Quantity tolerance allowed against the ordered quantity, in percent.
  variationPercent   Decimal? @map("variation_percent") @db.Decimal(5, 2)

  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  order    ExportOrder @relation(fields: [orderId], references: [id])
  supplier Supplier    @relation(fields: [supplierId], references: [id])
  items    ProcurementItem[]

  @@map("procurements")
}

// A line on a purchase order, at the supplier's price.
//
// The purchase order previously had no lines of its own, so the document printed
// the export order's items - which carry the price quoted to the BUYER, margin
// included. That showed a supplier the selling price, and left the item column
// summing to the order value while the TOTAL box showed the agreed supplier figure.
//
// These lines are priced from the supplier's own price list (see SupplierPrice) and
// are what the purchase order total is computed from.
model ProcurementItem {
  id            String   @id @default(cuid())
  procurementId String   @map("procurement_id")
  productId     String   @map("product_id")
  quantity      Decimal  @db.Decimal(12, 3)
  unit          String   @default("KG")
  /// Supplier's price per unit, in INR.
  rate          Decimal  @db.Decimal(12, 2)
  /// GST percent applied to this line, prefilled from Product.gstRate.
  taxPercent    Decimal? @map("tax_percent") @db.Decimal(5, 2)
  /// rate x quantity. The taxable value of the line.
  amount        Decimal  @db.Decimal(15, 2)
  /// amount x taxPercent / 100, computed on write.
  taxAmount     Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  procurement Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([procurementId])
  @@map("procurement_items")
}

model Document {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  documentType String   @map("document_type") // INVOICE, PACKING_LIST, BL, COO, etc.
  documentNo   String?  @map("document_no")
  status       String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  filePath     String?  @map("file_path")
  notes        String?
  dueDate      DateTime? @map("due_date")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  order ExportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Attachments linked to this document
  attachments Attachment[] @relation("DocumentAttachments")

  @@map("documents")
}

// Generic file attachment for any entity.
// Stores uploaded files (PDF, images, documents) linked to orders, inquiries, etc.
model Attachment {
  id            String   @id @default(cuid())
  // The entity this file is attached to
  entityType    String   @map("entity_type") // ORDER, INQUIRY, DOCUMENT, QUOTATION
  entityId      String   @map("entity_id")
  // Optional link to a specific order document for organization
  documentId    String?  @map("document_id")
  // File info
  fileName      String   @map("file_name")
  originalName  String   @map("original_name")
  mimeType      String   @map("mime_type")
  fileSize      Int      @map("file_size") // bytes
  filePath      String   @map("file_path") // relative path in uploads folder
  // Metadata
  description   String?
  uploadedById  String   @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  uploadedBy User     @relation(fields: [uploadedById], references: [id])
  document   Document? @relation("DocumentAttachments", fields: [documentId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([documentId])
  @@map("attachments")
}

model Shipment {
  id                String      @id @default(cuid())
  orderId           String      @map("order_id")
  shipmentNumber    String      @unique @map("shipment_number")
  chaId             String?     @map("cha_id")
  transporterId     String?     @map("transporter_id")
  originPortId      String?     @map("origin_port_id")
  destinationPortId String?     @map("destination_port_id")
  status            String      @default("PENDING") // PENDING, BOOKED, IN_TRANSIT, ARRIVED, DELIVERED
  containerNumber   String?     @map("container_number")
  containerType     String?     @map("container_type") // 20FT, 40FT, 40HC, LCL
  blNumber          String?     @map("bl_number")
  vesselName        String?     @map("vessel_name")
  etd               DateTime?
  eta               DateTime?
  actualDeparture   DateTime?   @map("actual_departure")
  actualArrival     DateTime?   @map("actual_arrival")
  freightCost       Decimal?    @map("freight_cost") @db.Decimal(12, 2)
  // What the CHA and the transporter actually charged for this shipment, in INR.
  //
  // Distinct from CHARate and TransportRate, which are rate cards used to price a
  // quotation, and from QuotationCost, which is the estimate quoted to the buyer.
  // These are the amounts owed, and entering one produces the matching expense -
  // see services/expenseSyncService.ts.
  chaCharges        Decimal?    @map("cha_charges") @db.Decimal(12, 2)
  transportCharges  Decimal?    @map("transport_charges") @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Relations
  order           ExportOrder  @relation(fields: [orderId], references: [id])
  cha             CHA?         @relation(fields: [chaId], references: [id])
  transporter     Transporter? @relation(fields: [transporterId], references: [id])
  originPort      Port?        @relation("ShipmentOriginPort", fields: [originPortId], references: [id])
  destinationPort Port?        @relation("ShipmentDestinationPort", fields: [destinationPortId], references: [id])

  @@map("shipments")
}



// ============================================
// FINANCE
// ============================================

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique @map("invoice_number")
  orderId        String        @map("order_id")
  buyerId        String        @map("buyer_id")
  type           String        @default("COMMERCIAL") // COMMERCIAL, PROFORMA, SAMPLE, PACKING_LIST - see apps/api/src/utils/invoiceTypes.ts
  status         InvoiceStatus @default(DRAFT)
  invoiceDate    DateTime      @map("invoice_date")
  dueDate        DateTime      @map("due_date")
  subtotal       Decimal       @db.Decimal(15, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(15, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(15, 2)
  balanceAmount  Decimal       @map("balance_amount") @db.Decimal(15, 2)
  // See Quotation.pdfCurrency. Defaults from the originating quotation.
  pdfCurrency     String?      @map("pdf_currency")
  pdfExchangeRate Decimal?     @map("pdf_exchange_rate") @db.Decimal(12, 6)
  pdfGeneratedAt  DateTime?    @map("pdf_generated_at")
  notes          String?
  // Why a sample shipment carries a declared value but no payment. Prints in the
  // Purpose box of the sample invoice, which customs reads to understand why duty
  // is being assessed on goods nobody is paying for. Null falls back to the
  // standard wording rather than printing an empty box.
  purpose        String?
  termsConditions String?      @map("terms_conditions")
  pdfPath        String?       @map("pdf_path")
  sentAt         DateTime?     @map("sent_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  order    ExportOrder @relation(fields: [orderId], references: [id])
  buyer    Buyer       @relation(fields: [buyerId], references: [id])
  payments Payment[]
  incomeEntries Income[]

  @@map("invoices")
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String   @map("invoice_id")
  paymentNumber String   @unique @map("payment_number")
  // The INR actually credited. Recording the realised rupee figure rather than a
  // foreign amount plus a rate means forex gain or loss is simply the difference
  // between this and the invoice, with nothing derived.
  amount        Decimal  @db.Decimal(15, 2)
  // What the remittance looked like before conversion, when the money arrived in
  // a foreign currency. REFERENCE ONLY - kept so a bank advice can be reconciled
  // against the entry. `amount` above is the sole figure used in any total, so
  // these can never disagree with a report.
  receivedCurrency String?  @map("received_currency")
  receivedAmount   Decimal? @map("received_amount") @db.Decimal(15, 2)
  exchangeRate     Decimal? @map("exchange_rate") @db.Decimal(12, 6)
  paymentDate   DateTime @map("payment_date")
  paymentMode   String   @map("payment_mode") // WIRE, LC, TT, CHEQUE
  reference     String?
  bankDetails   String?  @map("bank_details")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model Expense {
  id           String   @id @default(cuid())
  expenseNumber String  @unique @map("expense_number")
  category     String   // SUPPLIER_PAYMENT, FREIGHT, CHA, TRANSPORT, PACKAGING, TRAVEL, OFFICE, OTHER
  description  String
  // INR.
  amount       Decimal  @db.Decimal(12, 2)
  expenseDate  DateTime @map("expense_date")
  vendorName   String?  @map("vendor_name")
  invoiceRef   String?  @map("invoice_ref")
  status       String   @default("PENDING") // PENDING, APPROVED, PAID, REJECTED

  // Where this expense came from.
  //
  // MANUAL is typed in by hand. Everything else was generated from an operational
  // record - a supplier procurement, or the freight, CHA and transport costs on a
  // shipment - so that filling those in produces the payable without anyone
  // re-entering it.
  //
  // (sourceType, sourceId) is unique: it is what makes generation idempotent.
  // Saving a shipment twice updates the one expense rather than creating a second,
  // and the guarantee is the database's rather than the calling code's. sourceId is
  // null for MANUAL rows, and Postgres treats nulls as distinct in a unique index,
  // so any number of manual expenses coexist.
  sourceType   String   @default("MANUAL") @map("source_type")
  sourceId     String?  @map("source_id")

  /// Set when the expense was generated, so the UI can lock the amount.
  isGenerated  Boolean  @default(false) @map("is_generated")

  // Money actually paid out, and what is still owed.
  //
  // Mirrors Invoice.paidAmount / balanceAmount so that money leaving the business
  // is tracked the same way as money arriving. `status` is derived from these by
  // the payment route rather than set by hand: an expense with a nil balance is
  // PAID, and one part paid stays APPROVED with a balance showing.
  paidAmount    Decimal @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount Decimal @default(0) @map("balance_amount") @db.Decimal(12, 2)

  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  payments ExpensePayment[]

  @@unique([sourceType, sourceId])
  @@index([category])
  @@index([status])
  @@index([expenseDate])
  @@map("expenses")
}

// A payment made against an expense.
//
// The outgoing counterpart of Payment. Suppliers are routinely paid in parts - an
// advance against the purchase order and the balance on delivery - so a single
// paid flag on the expense cannot represent what is actually owed.
//
// Amounts are INR, like every monetary column in this schema.
model ExpensePayment {
  id          String   @id @default(cuid())
  expenseId   String   @map("expense_id")
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @map("payment_date")
  /// BANK_TRANSFER, CHEQUE, CASH, UPI, CARD
  method      String   @default("BANK_TRANSFER")
  /// UTR, cheque number or other proof the money left the account.
  reference   String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([paymentDate])
  @@map("expense_payments")
}

model Income {
  id               String   @id @default(cuid())
  incomeNumber     String   @unique @map("income_number")
  category         String   // EXPORT_REVENUE, FOREX_GAIN, INTEREST, DUTY_DRAWBACK, MEIS_SCRIP, OTHER
  description      String
  originalAmount   Decimal  @map("original_amount") @db.Decimal(15, 2)
  originalCurrency String   @default("INR") @map("original_currency")
  exchangeRate     Decimal  @default(1) @map("exchange_rate") @db.Decimal(10, 4)
  amountINR        Decimal  @map("amount_inr") @db.Decimal(15, 2)
  receivedDate     DateTime @map("received_date")
  reference        String?
  linkedInvoiceId  String?  @map("linked_invoice_id")
  status           String   @default("PENDING") // PENDING, RECEIVED
  notes            String?
  createdById      String   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  linkedInvoice Invoice? @relation(fields: [linkedInvoiceId], references: [id])
  createdBy     User     @relation(fields: [createdById], references: [id])

  @@map("income")
}

model CompanyProfile {
  id                 String   @id @default(cuid())
  legalName          String   @map("legal_name")
  tradeName          String?  @map("trade_name")
  addressLine1       String?  @map("address_line_1")
  addressLine2       String?  @map("address_line_2")
  city               String?
  state              String?
  postalCode         String?  @map("postal_code")
  country            String   @default("India")
  originCountry      String   @default("India") @map("origin_country")
  gstNumber          String?  @map("gst_number")
  iecCode            String?  @map("iec_code")
  phone              String?
  contactPerson      String?  @map("contact_person")
  email              String?
  website            String?
  bankName           String?  @map("bank_name")
  bankBranch         String?  @map("bank_branch")
  bankAccountNo      String?  @map("bank_account_no")
  bankBeneficiary    String?  @map("bank_beneficiary")
  bankSwiftCode      String?  @map("bank_swift_code")
  bankIfscCode       String?  @map("bank_ifsc_code")
  bankChargesNote    String?  @map("bank_charges_note")
  quotationTerms     String?  @map("quotation_terms")
  // Terms printed on a purchase order sent to a supplier. Editable for the same
  // reason quotationTerms is: they are the exporter's own trading conditions, and
  // hardcoding them meant a change needed a deployment.
  purchaseOrderTerms String?  @map("purchase_order_terms")
  invoiceDeclaration String?  @map("invoice_declaration")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("company_profile")
}



// ============================================
// TEAM & TASKS
// ============================================

model Employee {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  employeeCode String   @unique @map("employee_code")
  department   String
  designation  String
  joiningDate  DateTime @map("joining_date")
  reportingTo  String?  @map("reporting_to")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("employees")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  assigneeId  String       @map("assignee_id")
  createdById String       @map("created_by_id")
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  dueDate     DateTime?    @map("due_date")
  completedAt DateTime?    @map("completed_at")
  relatedType String?      @map("related_type") // INQUIRY, ORDER, SHIPMENT, etc.
  relatedId   String?      @map("related_id")
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  assignee  User @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@map("tasks")
}

// ============================================
// SYSTEM & AUDIT
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   // CREATE, UPDATE, DELETE
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("STRING") // STRING, NUMBER, BOOLEAN, JSON
  category  String   @default("GENERAL")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model NumberSequence {
  id          String   @id @default(cuid())
  entityType  String   @unique @map("entity_type") // INQUIRY, QUOTATION, ORDER, INVOICE, etc.
  prefix      String
  currentNo   Int      @default(0) @map("current_no")
  padLength   Int      @default(5) @map("pad_length")
