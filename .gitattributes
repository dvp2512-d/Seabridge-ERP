# Normalise line endings so the repo stays consistent across Windows/macOS/Linux.
# Text files are stored with LF in git and checked out natively on Windows.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or they can fail to run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must keep LF or they fail inside Linux containers.
*.sh text eol=lf

# Treat these as binary so git never rewrites their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary

# Lockfiles: keep diffs collapsed in reviews.
package-lock.json linguist-generated=true -diff

# SQL migrations are source, not generated noise.
*.sql text eol=lf
